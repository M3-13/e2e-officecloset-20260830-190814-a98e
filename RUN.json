{
  "runcontract": 1,
  "services": [
    {
      "name": "frontend",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [["npm", "install"]],
      "build": [["npm", "run", "build"]],
      "start": [
        "npm",
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "${PORT}"
      ],
      "port": 5173,
      "port_env": "PORT",
      "health": { "path": "/", "expect_status": [200] }
    }
  ]
}
