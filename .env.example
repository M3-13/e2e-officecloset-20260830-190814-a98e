# Vorlage für die Umgebungsvariablen des Backends.
# Kopieren zu `.env` (oder exportieren) und Werte vor dem Start setzen.

# JWT-Signatur-Geheimnis — erforderlich. Einmal pro Umgebung erzeugen:
#   py -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional — Standardwerte sind bereits lauffähig:
#   DATABASE_URL=sqlite:///./wardrobe.db
#   CORS_ORIGIN=http://localhost:5173
